# Library storage. 'local' (default) keeps documents/images on this device.
# 'supabase' enables cloud sync and requires Supabase auth.
VITE_BACKEND=local

# Authentication. Empty defaults to VITE_BACKEND. Set 'supabase' with local
# storage for real owner login WITHOUT cloud sync; 'local' is offline simulation.
# Allowed auth/storage: local/local, supabase/local, supabase/supabase.
VITE_AUTH_BACKEND=

# Required for real-auth library access: the owner's immutable auth user id/sub,
# never an email or user_metadata field. Missing or mismatched ids deny access.
VITE_PRIVATE_OWNER_ID=

# Relay stays unconfigured in public/demo builds. Configuring auth does not
# activate paid functionality; relay activation requires separate approval.
VITE_AI_RELAY_URL=

# Curated DEFAULT_ARTISTS seeding is only for offline simulated auth, and only
# this email. A real-auth account never receives this seed from an email match.
VITE_OWNER_EMAIL=owner@example.com

# Required when auth or storage uses Supabase. The anon key is publishable, but Row Level
# Security MUST be enabled on the collections table and the storage bucket before
# any real data lands, or rows/objects are world-readable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Once the share-to-Sable Shortcut (docs/02-managing-artists.md) has
# been built in the Shortcuts app and shared as an iCloud link (Share → Copy
# iCloud Link), paste it here — Settings then shows a one-tap install button
# on iOS instead of the manual four-step recipe (#45).
VITE_IOS_SHORTCUT_URL=
