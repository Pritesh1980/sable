# Private server configuration only. Never put these secrets in VITE_* variables.
# This file does not activate/provision the relay. Startup wiring is a later task.
RELAY_DATA_DIR=/absolute/private/path/to/sable-relay
RELAY_OWNER_ID=replace-with-the-owner-auth-sub
RELAY_ISSUER=https://your-project.supabase.co/auth/v1
RELAY_AUDIENCE=authenticated
# Configure exactly the project's single asymmetric algorithm: ES256 or RS256.
RELAY_ALGORITHM=ES256
# Exact comma-separated origins: no slash/path/wildcards/credentials. HTTPS except
# local development at localhost, 127.0.0.1 or [::1]. No implicit origin defaults.
RELAY_ORIGINS=https://private-sable.example
# JWKS is derived from the exact issuer. If supplied, this must match it exactly.
# RELAY_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Fixed implementation candidate, not verified account/model access.
RELAY_PROFILE_ID=openai-refine-v1
RELAY_MODEL=gpt-image-2.5-sunburst
RELAY_PAID_ENABLED=false
# May be absent/empty only while disabled. Separate approval is needed to activate.
RELAY_OPENAI_API_KEY=
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
# Positive integer milliseconds; these defaults are also the upper bounds.
RELAY_UPLOAD_TIMEOUT_MS=30000
RELAY_PROVIDER_TIMEOUT_MS=120000
# Private activation also requires invite-only auth and 900-second access tokens.
# JWKS cache: up to 10 minutes locally, 30-second cooldown, 5-second fetch timeout.
# Supabase's edge cache may add another 10 minutes; logout/revocation is not instant.
